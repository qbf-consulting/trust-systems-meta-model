{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsmm:schema:decision-resolution-semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "version", "invariants", "provenance"],
  "properties": {
    "$schema": {"type": "string"},
    "modelId": {"const": "urn:tsmm:model:decision-resolution-semantics"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "invariants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^TSMM-DR-[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 20},
          "failurePattern": {"type": "string"},
          "basisCategories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "admissibleResolutionCategories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "normativeDependency", "sources"],
      "properties": {
        "relationship": {"const": "research-informed"},
        "normativeDependency": {"const": false},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
      }
    }
  }
}
