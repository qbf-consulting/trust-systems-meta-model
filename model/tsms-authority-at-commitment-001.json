{
  "caseId": "TSMS-AUTH-COMMIT-001",
  "proposition": "A material commitment is permitted only when the exact action is bound to current action-specific authority, all material constraints are satisfied, and any required approval is present and bound to the same action.",
  "portableContract": "governance/authority-at-commitment.schema.json",
  "executableControl": "control.authority-at-commitment",
  "positive": {
    "identityAuthenticated": true,
    "signatureValid": true,
    "authorityState": "active",
    "scopeAllowed": true,
    "actionDigestMatches": true,
    "approvalRequired": true,
    "approvalPresent": true,
    "approvalDigestMatches": true,
    "constraints": [
      "satisfied",
      "satisfied"
    ],
    "expected": "PERMIT"
  },
  "negativeCases": [
    {
      "id": "identity-only",
      "identityAuthenticated": true,
      "signatureValid": true,
      "authorityState": "unknown",
