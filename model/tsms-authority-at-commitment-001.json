      "approvalDigestMatches": false,
      "constraints": [
        "satisfied"
      ],
      "expected": "INDETERMINATE"
    },
    {
      "id": "out-of-scope",
      "identityAuthenticated": true,
      "signatureValid": true,
      "authorityState": "active",
      "scopeAllowed": false,
      "actionDigestMatches": true,
      "approvalRequired": false,
      "approvalPresent": false,
      "approvalDigestMatches": false,
      "constraints": [
        "satisfied"
      ],
      "expected": "DENY"
    },
    {
      "id": "revoked",
      "identityAuthenticated": true,
      "signatureValid": true,
      "authorityState": "revoked",
